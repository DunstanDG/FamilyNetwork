# Copy to .env next to compose.yaml on the Proxmox box. Never commit the real file.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Only the gateway holds this. It never goes in the app or the repo.
SUPABASE_SERVICE_ROLE_KEY=

# Immich, as seen from inside the Docker network (or http://<immich-lxc-ip>:2283)
IMMICH_URL=http://immich-server:2283
# Immich -> Account settings -> API keys. Give it only: asset.upload, asset.read, asset.view,
# asset.download, asset.delete.
IMMICH_API_KEY=

# The app's address (scheme + host, no path). Add http://localhost:5173 while developing.
ALLOWED_ORIGINS=https://YOUR-GITHUB-USERNAME.github.io

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

MAX_UPLOAD_MB=40
