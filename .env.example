# Copy to .env.local for local development. Never commit real values to a public repo's source
# (the anon key and VAPID public key are safe to expose in the built app; they are not secrets).

# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push public key (generate a pair with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Only needed if the app is not served from https://<user>.github.io/FamilyNetwork/
# BASE_PATH=/
